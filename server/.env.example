# انسخ هذا الملف باسم .env واملأ القيم الحقيقية قبل التشغيل

PORT=5000

# رابط قاعدة بيانات MongoDB (محلي أو MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/waraqah

# مفتاح سري طويل وعشوائي لتوقيع رموز JWT - غيّره إجباريًا قبل النشر
JWT_SECRET=REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_STRING

# مدة صلاحية رمز الدخول
JWT_EXPIRES_IN=7d

# رابط الواجهة الأمامية (لإعدادات CORS) - عدّله لدومين موقعك عند النشر
CLIENT_ORIGIN=http://localhost:5500

# =============================================================
# Gmail SMTP - لإرسال إيميلات استعادة كلمة السر
# =============================================================
# GMAIL_USER: إيميل Gmail اللي هيبعت منه الرسائل (مثلاً waraqah.magazine@gmail.com)
# GMAIL_APP_PASSWORD: مش كلمة سر Gmail العادية! لازم "App Password" مخصصة:
#   1. فعّل "التحقق بخطوتين" على حساب الـ Gmail من myaccount.google.com/security
#   2. روح لـ myaccount.google.com/apppasswords وأنشئ App Password جديدة باسم "Waraqah"
#   3. انسخ الـ 16 حرف اللي هتظهرلك وحطهم هنا (من غير مسافات)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD

# رابط الواجهة الأمامية لصفحة إعادة تعيين كلمة السر (يتحط في رابط الإيميل)
PASSWORD_RESET_URL=http://localhost:3000/reset-password.html

# =============================================================
# Paymob - بوابة الدفع (فيزا/ماستركارد + فودافون كاش/اتصالات كاش/أورانج موني/وي باي)
# =============================================================
# سجّل حساب على accept.paymob.com واحصل على القيم دي من لوحة تحكمك هناك:
# PAYMOB_API_KEY: من Settings > Account Info > API Key
# PAYMOB_INTEGRATION_ID_CARD: من Developers > Payment Integrations (كارت الفيزا/ماستركارد)
# PAYMOB_INTEGRATION_ID_WALLET: من Developers > Payment Integrations (المحافظ الإلكترونية - Mobile Wallet)
# PAYMOB_IFRAME_ID: من Developers > Payment Integrations > iframes
# PAYMOB_HMAC_SECRET: من Settings > Account Info > HMAC Secret (للتحقق من صحة إشعارات الدفع)
PAYMOB_API_KEY=REPLACE_WITH_YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID_CARD=REPLACE_WITH_CARD_INTEGRATION_ID
PAYMOB_INTEGRATION_ID_WALLET=REPLACE_WITH_WALLET_INTEGRATION_ID
PAYMOB_IFRAME_ID=REPLACE_WITH_IFRAME_ID
PAYMOB_HMAC_SECRET=REPLACE_WITH_HMAC_SECRET

# سعر العضوية الذهبية بالجنيه المصري (مثال: 100 جنيه)
GOLD_MEMBERSHIP_PRICE_EGP=100

# =============================================================
# Cloudinary - تخزين الصور والملفات الصوتية (ضروري لو هتنشر على Vercel)
# =============================================================
# سجّل حساب مجاني على cloudinary.com، وهتلاقي الثلاث قيم دي جاهزة في الـ Dashboard
# الرئيسية فور الدخول (من غير أي إعداد إضافي):
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_YOUR_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_API_SECRET

